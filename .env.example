# Required — use either this pair OR the legacy names below
TELEGRAM_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=@YourChannelOrNumericId

# Legacy (still supported if TELEGRAM_* not set)
# BOT_TOKEN=
# CHANNEL_ID=

# Polling (seconds)
POLL_INTERVAL=60

# Optional: separate interval for DEX Paid monitor (defaults to POLL_INTERVAL)
# DEX_PAID_POLL_INTERVAL=60

# Feature toggles (default true)
ENABLE_LIQUIDITY=true
ENABLE_DEX_PAID=true

# Liquidity radar: minimum USD liquidity to alert (default 1000)
MIN_LIQUIDITY=1000
